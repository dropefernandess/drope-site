# Resend — envio de email via /calculadora form
# Cria conta grátis em resend.com (3K emails/mês free)
# 1. Verifica seu domínio dropefernandes.com no painel Resend
# 2. Gera API key em Settings → API Keys
# 3. Cola aqui e adiciona no Vercel: Project Settings → Environment Variables
RESEND_API_KEY=

# Não é mais usada: o endereço oficial (www) fica em lib/config.ts (SITE.url).
# NEXT_PUBLIC_SITE_URL=https://www.dropefernandes.com

# Agenda própria (/agendar) ligada ao Google Agenda do Pedro.
# Sem estas três, a página continua mostrando o Cal.com.
# Passo a passo em "Rebrand 2026/20-AGENDA-GOOGLE.md". Nunca cole os valores em chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opcional: agenda onde o evento é criado (padrão: primary)
GOOGLE_CALENDAR_ID=
# Opcional: outras agendas que também bloqueiam horário, separadas por vírgula
GOOGLE_BUSY_CALENDARS=
# Só para testar no computador: simula o Google (ignorado em produção)
# AGENDA_MOCK=1
