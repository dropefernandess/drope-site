# Resend — envio de email via /calculadora form
# Cria conta grátis em resend.com (3K emails/mês free)
# 1. Verifica seu domínio dropefernandes.com no painel Resend
# 2. Gera API key em Settings → API Keys
# 3. Cola aqui e adiciona no Vercel: Project Settings → Environment Variables
RESEND_API_KEY=

# URL canônica do site (usada em robots.ts, sitemap.ts e Resend email)
# Antes do domínio próprio: deixa o default https://dropefernandes.com
NEXT_PUBLIC_SITE_URL=https://dropefernandes.com
